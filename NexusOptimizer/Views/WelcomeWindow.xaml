<Window x:Class="NexusOptimizer.Views.WelcomeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добро пожаловать в Nexus Optimizer"
        Width="1000"
        Height="760"
        MinWidth="820"
        MinHeight="620"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="{DynamicResource UiFont}">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Grid Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Width="48" Height="48" CornerRadius="15"
                    Background="{DynamicResource AccentBrush}">
                <TextBlock Text="N" FontSize="26" FontWeight="Bold" Foreground="White"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="Добро пожаловать в Nexus Optimizer"
                           Style="{DynamicResource PageTitleText}"/>
                <TextBlock Text="Проверим компьютер и подберём настройки. Вы сами решаете, что менять."
                           Style="{DynamicResource MutedText}"
                           Margin="0,4,0,0"/>
            </StackPanel>
        </Grid>

        <Border Grid.Row="1"
                Background="{DynamicResource WarningSoftBrush}"
                CornerRadius="12"
                Padding="14,10"
                Margin="0,0,0,16">
            <TextBlock Text="Поиск и анализ безопасны: настройки не применяются без вашего выбора. Драйверы программа только ищет через Windows Update — установка остаётся под вашим контролем."
                       Foreground="{DynamicResource BodyTextBrush}"
                       FontSize="12"
                       TextWrapping="Wrap"/>
        </Border>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300"/>
                <ColumnDefinition Width="14"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Style="{DynamicResource PanelCard}" Padding="18">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="Сканирование системы"
                                   Style="{DynamicResource SectionTitleText}"/>
                        <TextBlock x:Name="ScanStatusText"
                                   Text="Подготовка проверки..."
                                   Style="{DynamicResource MutedText}"
                                   TextWrapping="Wrap"
                                   Margin="0,7,0,12"/>
                        <Grid Height="64" Margin="0,0,0,10">
                            <Ellipse Width="52" Height="52"
                                     Stroke="{DynamicResource LineBrush}" StrokeThickness="4"/>
                            <Ellipse Width="52" Height="52"
                                     Stroke="{DynamicResource AccentBrush}" StrokeThickness="4"
                                     StrokeDashArray="1 2"
                                     RenderTransformOrigin="0.5,0.5">
                                <Ellipse.RenderTransform>
                                    <RotateTransform x:Name="ScanRotation"/>
                                </Ellipse.RenderTransform>
                            </Ellipse>
                            <TextBlock Text="N" FontSize="19" FontWeight="Bold"
                                       Foreground="{DynamicResource AccentTextBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <ProgressBar x:Name="ScanProgress" Height="4" IsIndeterminate="True"
                                     Visibility="Collapsed" Margin="0,0,0,14"/>

                        <TextBlock Text="Windows" Style="{DynamicResource MutedText}" Margin="0,8,0,2"/>
                        <TextBlock x:Name="WindowsText" Text="—" TextWrapping="Wrap"/>
                        <TextBlock Text="Процессор" Style="{DynamicResource MutedText}" Margin="0,8,0,2"/>
                        <TextBlock x:Name="ProcessorText" Text="—" TextWrapping="Wrap"/>
                        <TextBlock Text="Оперативная память" Style="{DynamicResource MutedText}" Margin="0,8,0,2"/>
                        <TextBlock x:Name="MemoryText" Text="—" TextWrapping="Wrap"/>
                        <TextBlock Text="Графика" Style="{DynamicResource MutedText}" Margin="0,8,0,2"/>
                        <TextBlock x:Name="GraphicsText" Text="—" TextWrapping="Wrap"/>

                        <Separator Margin="0,16,0,12"/>
                        <TextBlock Text="Обновления драйверов"
                                   Style="{DynamicResource SectionTitleText}"
                                   FontSize="14"/>
                        <TextBlock x:Name="DriverStatusText"
                                   Text="Поиск проверит официальный каталог Windows Update."
                                   Style="{DynamicResource MutedText}"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Margin="0,5,0,10"/>
                        <Button x:Name="DriverSearchButton"
                                Content="Проверить драйверы"
                                Click="DriverSearch_Click"/>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border Grid.Column="2" Style="{DynamicResource PanelCard}" Padding="18">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    <StackPanel>
                        <TextBlock Text="Рекомендации для компьютера"
                                   Style="{DynamicResource SectionTitleText}"/>
                        <TextBlock x:Name="RecommendationsStatusText"
                                   Text="Сканируем конфигурацию и текущие настройки..."
                                   Style="{DynamicResource MutedText}"
                                   TextWrapping="Wrap"
                                   Margin="0,5,0,12"/>
                    </StackPanel>
                    <Grid Grid.Row="1">
                        <TextBlock x:Name="EmptyStateText"
                                   Text="Идёт сканирование..."
                                   Foreground="{DynamicResource MutedBrush}"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   TextWrapping="Wrap"
                                   TextAlignment="Center"
                                   Margin="20"/>
                        <ScrollViewer x:Name="RecommendationsScroll"
                                      VerticalScrollBarVisibility="Auto"
                                      Visibility="Collapsed">
                            <ItemsControl x:Name="RecommendationsList">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource CardBrush}"
                                                BorderBrush="{DynamicResource LineBrush}"
                                                BorderThickness="1"
                                                CornerRadius="10"
                                                Padding="12"
                                                Margin="0,0,0,8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                          Checked="Recommendation_Checked"
                                                          Unchecked="Recommendation_Checked"
                                                          VerticalAlignment="Top"
                                                          Margin="0,2,10,0"/>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Text="{Binding Name}"
                                                               FontWeight="SemiBold"
                                                               TextWrapping="Wrap"/>
                                                    <TextBlock Text="{Binding Reason}"
                                                               Style="{DynamicResource MutedText}"
                                                               FontSize="12"
                                                               TextWrapping="Wrap"
                                                               Margin="0,5,0,0"/>
                                                    <TextBlock Text="{Binding Caution}"
                                                               Foreground="{DynamicResource WarningBrush}"
                                                               FontSize="11"
                                                               TextWrapping="Wrap"
                                                               Margin="0,5,0,0"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                    <TextBlock x:Name="WarningText"
                               Grid.Row="2"
                               Foreground="{DynamicResource WarningBrush}"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0"
                               Visibility="Collapsed"/>
                </Grid>
            </Border>
        </Grid>

        <Grid Grid.Row="3" Margin="0,14,0,0">
            <TextBlock x:Name="FooterStatusText"
                       Text="Вы можете применить выбранные изменения или продолжить без оптимизации."
                       Style="{DynamicResource MutedText}"
                       FontSize="11"
                       VerticalAlignment="Center"
                       Margin="0,0,12,0"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="ApplyButton"
                        Content="Применить выбранное"
                        Click="Apply_Click"
                        Style="{DynamicResource AccentButton}"
                        IsEnabled="False"
                        Margin="0,0,8,0"/>
                <Button Content="Позже"
                        Click="Later_Click"
                        IsDefault="True"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
