<Window x:Class="NexusOptimizer.Views.GameDetailsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Игра — Nexus Optimizer"
        Width="760"
        Height="620"
        MinWidth="620"
        MinHeight="500"
        WindowStartupLocation="CenterOwner"
        Background="#111318"
        Foreground="#F2F4F8">

    <Window.Resources>
        <SolidColorBrush x:Key="PanelBrush" Color="#191C23"/>
        <SolidColorBrush x:Key="CardBrush" Color="#20242D"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#303642"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#9AA3B2"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#4F8CFF"/>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#292F3A"/>
            <Setter Property="Foreground" Value="#F2F4F8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,10"/>
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Шапка -->
        <Border Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="14"
                Padding="18"
                Margin="0,0,0,16">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock x:Name="GameNameText"
                               Text="Название игры"
                               FontSize="24"
                               FontWeight="SemiBold"
                               TextWrapping="Wrap"/>

                    <TextBlock x:Name="GamePlatformText"
                               Text="Источник"
                               Foreground="{StaticResource MutedBrush}"
                               Margin="0,6,0,0"/>

                    <TextBlock x:Name="GamePathText"
                               Text="Путь установки"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="11"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0"/>
                </StackPanel>

                <Border Grid.Column="1"
                        Width="76"
                        Height="76"
                        CornerRadius="14"
                        Background="#293B5B"
                        Margin="14,0,0,0">
                    <Image x:Name="GameIconImage"
                           Width="64"
                           Height="64"
                           Stretch="Uniform"/>
                </Border>
            </Grid>
        </Border>

        <!-- Содержимое -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto">
            <StackPanel>

                <Border Background="{StaticResource PanelBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="18"
                        Margin="0,0,0,14">

                    <StackPanel>
                        <TextBlock Text="Об игре"
                                   FontSize="17"
                                   FontWeight="SemiBold"/>

                        <TextBlock x:Name="DescriptionText"
                                   Text="Загрузка описания..."
                                   TextWrapping="Wrap"
                                   Foreground="#D5DAE4"
                                   Margin="0,12,0,0"
                                   LineHeight="22"/>
                    </StackPanel>
                </Border>

                <Border Background="{StaticResource PanelBrush}"
                        BorderBrush="{StaticResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="12"
                        Padding="18">

                    <StackPanel>
                        <TextBlock Text="Оптимизация"
                                   FontSize="17"
                                   FontWeight="SemiBold"/>

                        <TextBlock Text="Безопасный профиль запуска"
                                   FontSize="13"
                                   FontWeight="SemiBold"
                                   Margin="0,14,0,4"/>

                        <TextBlock Text="При прямом запуске игры программа попробует установить приоритет процесса «Выше обычного». Это не гарантирует рост FPS. Системные службы и настройки BIOS не изменяются."
                                   TextWrapping="Wrap"
                                   Foreground="{StaticResource MutedBrush}"
                                   LineHeight="20"/>

                        <CheckBox x:Name="OptimizeOnLaunchCheckBox"
                                  Content="Применять приоритет «Выше обычного» при запуске"
                                  IsChecked="True"
                                  Foreground="#F2F4F8"
                                  Margin="0,14,0,0"/>

                        <TextBlock x:Name="OptimizationStatusText"
                                   Text="Профиль ещё не применён"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="11"
                                   Margin="0,10,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Кнопки -->
        <DockPanel Grid.Row="2" Margin="0,16,0,0">
            <TextBlock x:Name="WindowStatusText"
                       Text="Готово"
                       Foreground="{StaticResource MutedBrush}"
                       VerticalAlignment="Center"/>

            <StackPanel Orientation="Horizontal"
                        DockPanel.Dock="Right">
                <Button Content="Открыть папку"
                        Click="OpenFolder_Click"/>

                <Button Content="Запустить игру"
                        Click="LaunchGame_Click"
                        Background="{StaticResource AccentBrush}"
                        Foreground="White"
                        Margin="0"/>
            </StackPanel>
        </DockPanel>
    </Grid>
</Window>
