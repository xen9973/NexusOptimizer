<UserControl x:Class="NexusOptimizer.Views.GameDetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Button Grid.Row="0"
                Content="←  Назад в библиотеку"
                Click="Back_Click"
                HorizontalAlignment="Left"
                Padding="14,9"
                Margin="0,0,0,16"/>

        <ScrollViewer x:Name="PageScroll"
                      Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="0,0,12,0">

                <!-- Шапка игры -->
                <Border Style="{DynamicResource PanelCard}" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <Border Width="320"
                                Height="150"
                                Background="{DynamicResource CardBrush}"
                                VerticalAlignment="Top"
                                Margin="0,0,22,0">
                            <Border.Clip>
                                <RectangleGeometry Rect="0,0,320,150" RadiusX="12" RadiusY="12"/>
                            </Border.Clip>
                            <Grid>
                                <Image x:Name="GameIconImage"
                                       Width="64"
                                       Height="64"
                                       Stretch="Uniform"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                                <Image x:Name="HeaderImage"
                                       Stretch="UniformToFill"
                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Grid>
                        </Border>

                        <StackPanel Grid.Column="1">
                            <TextBlock x:Name="GameNameText"
                                       Style="{DynamicResource PageTitleText}"
                                       TextWrapping="Wrap"/>
                            <TextBlock x:Name="GamePlatformText"
                                       Style="{DynamicResource MutedText}"
                                       Margin="0,6,0,0"/>
                            <TextBlock x:Name="GenresText"
                                       Foreground="{DynamicResource AccentTextBrush}"
                                       FontSize="13"
                                       TextWrapping="Wrap"
                                       Margin="0,10,0,0"
                                       Visibility="Collapsed"/>
                            <TextBlock x:Name="MetaText"
                                       Style="{DynamicResource MutedText}"
                                       FontSize="12"
                                       LineHeight="19"
                                       TextWrapping="Wrap"
                                       Margin="0,8,0,0"
                                       Visibility="Collapsed"/>
                            <TextBlock x:Name="GamePathText"
                                       Style="{DynamicResource MutedText}"
                                       FontSize="11"
                                       TextWrapping="Wrap"
                                       Margin="0,10,0,0"/>

                            <WrapPanel Margin="0,16,0,0">
                                <Button Content="Запустить игру"
                                        Click="LaunchGame_Click"
                                        Style="{DynamicResource AccentButton}"
                                        Padding="24,11"
                                        Margin="0,0,8,8"/>
                                <Button Content="Открыть папку"
                                        Click="OpenFolder_Click"
                                        Padding="16,11"
                                        Margin="0,0,8,8"/>
                                <Button x:Name="StoreButton"
                                        Content="Страница в Steam"
                                        Click="OpenStore_Click"
                                        Padding="16,11"
                                        Margin="0,0,0,8"
                                        Visibility="Collapsed"/>
                            </WrapPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Скриншоты -->
                <Border x:Name="GalleryCard"
                        Style="{DynamicResource PanelCard}"
                        Margin="0,0,0,16"
                        Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Скриншоты" Style="{DynamicResource SectionTitleText}"/>

                        <Border Height="360"
                                Background="{DynamicResource InputBrush}"
                                CornerRadius="12"
                                Margin="0,14,0,12">
                            <Image Source="{Binding SelectedItem.FullUrl, ElementName=ScreenshotList}"
                                   Stretch="Uniform"
                                   RenderOptions.BitmapScalingMode="HighQuality"/>
                        </Border>

                        <ListBox x:Name="ScreenshotList"
                                 Style="{DynamicResource ThumbListBoxStyle}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Image Source="{Binding ThumbnailUrl}"
                                           Width="128"
                                           Height="72"
                                           Stretch="UniformToFill"/>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>

                <!-- Описание -->
                <Border Style="{DynamicResource PanelCard}" Margin="0,0,0,16">
                    <StackPanel HorizontalAlignment="Left" MaxWidth="780">
                        <TextBlock Text="Об игре" Style="{DynamicResource SectionTitleText}"/>
                        <TextBlock x:Name="ShortDescriptionText"
                                   Foreground="{DynamicResource TextBrush}"
                                   FontSize="14"
                                   LineHeight="22"
                                   TextWrapping="Wrap"
                                   Margin="0,12,0,0"
                                   Visibility="Collapsed"/>
                        <TextBlock x:Name="DescriptionText"
                                   Foreground="{DynamicResource BodyTextBrush}"
                                   FontSize="13"
                                   LineHeight="21"
                                   TextWrapping="Wrap"
                                   Margin="0,12,0,0"/>
                    </StackPanel>
                </Border>

                <!-- Оптимизация игры -->
                <Border Style="{DynamicResource PanelCard}" Margin="0,0,0,8">
                    <StackPanel HorizontalAlignment="Left" MaxWidth="780">
                        <TextBlock Text="Оптимизация игры" Style="{DynamicResource SectionTitleText}"/>
                        <TextBlock Style="{DynamicResource MutedText}"
                                   TextWrapping="Wrap"
                                   LineHeight="20"
                                   Margin="0,8,0,0"
                                   Text="Профиль применяется к файлам игры, запускать её для этого не нужно. Каждое действие описано ниже: что оно меняет, чем рискует и как отменяется. Прирост FPS не гарантирован."/>
                        <TextBlock x:Name="TweakTargetsText"
                                   Style="{DynamicResource MutedText}"
                                   FontSize="11"
                                   TextWrapping="Wrap"
                                   Margin="0,8,0,0"/>

                        <TextBlock Text="Профиль"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource BodyTextBrush}"
                                   Margin="0,18,0,8"/>
                        <ListBox x:Name="ProfileList"
                                 Style="{DynamicResource ChipListBoxStyle}"
                                 SelectionChanged="ProfileList_SelectionChanged"/>
                        <TextBlock x:Name="ProfileDescriptionText"
                                   Style="{DynamicResource MutedText}"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Margin="0,10,0,0"/>

                        <ItemsControl x:Name="ActionsList" Margin="0,16,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="{DynamicResource CardBrush}"
                                            BorderBrush="{DynamicResource LineBrush}"
                                            BorderThickness="1"
                                            CornerRadius="12"
                                            Padding="16"
                                            Margin="0,0,0,10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                            </Grid.ColumnDefinitions>

                                            <CheckBox Grid.Column="0"
                                                      IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                      IsEnabled="{Binding IsAvailable}"
                                                      VerticalAlignment="Top"
                                                      Margin="0,1,6,0"/>

                                            <StackPanel Grid.Column="1" Margin="0,0,14,0">
                                                <WrapPanel>
                                                    <TextBlock Text="{Binding Title}"
                                                               FontSize="14"
                                                               FontWeight="SemiBold"
                                                               Foreground="{DynamicResource TextBrush}"
                                                               VerticalAlignment="Center"
                                                               Margin="0,0,10,0"/>
                                                    <Border CornerRadius="8" Padding="8,2" VerticalAlignment="Center">
                                                        <Border.Style>
                                                            <Style TargetType="Border">
                                                                <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsMediumRisk}" Value="True">
                                                                        <Setter Property="Background" Value="{DynamicResource WarningSoftBrush}"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </Border.Style>
                                                        <TextBlock Text="{Binding RiskText}" FontSize="11" FontWeight="SemiBold">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsMediumRisk}" Value="True">
                                                                            <Setter Property="Foreground" Value="{DynamicResource WarningBrush}"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </Border>
                                                </WrapPanel>

                                                <TextBlock Text="{Binding Description}"
                                                           Style="{DynamicResource MutedText}"
                                                           FontSize="12"
                                                           LineHeight="18"
                                                           TextWrapping="Wrap"
                                                           Margin="0,6,0,0"/>
                                                <TextBlock Text="{Binding DetailsText}"
                                                           Style="{DynamicResource MutedText}"
                                                           FontSize="11"
                                                           LineHeight="17"
                                                           TextWrapping="Wrap"
                                                           Margin="0,6,0,0"/>
                                                <TextBlock Text="{Binding RiskNote}"
                                                           Style="{DynamicResource MutedText}"
                                                           FontSize="11"
                                                           TextWrapping="Wrap"
                                                           Margin="0,4,0,0"/>
                                                <TextBlock Text="{Binding StateText}"
                                                           Foreground="{DynamicResource BodyTextBrush}"
                                                           FontSize="12"
                                                           FontWeight="SemiBold"
                                                           TextWrapping="Wrap"
                                                           Margin="0,8,0,0"/>
                                                <TextBlock Text="{Binding ResultText}"
                                                           Foreground="{DynamicResource AccentTextBrush}"
                                                           FontSize="12"
                                                           TextWrapping="Wrap"
                                                           Margin="0,2,0,0"/>
                                            </StackPanel>

                                            <Button Grid.Column="2"
                                                    Content="Отменить"
                                                    Tag="{Binding}"
                                                    Click="RevertAction_Click"
                                                    IsEnabled="{Binding IsActive}"
                                                    VerticalAlignment="Top"
                                                    Padding="14,8"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBlock Text="Аргументы запуска"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource BodyTextBrush}"
                                   Margin="0,10,0,6"/>
                        <TextBox x:Name="LaunchArgumentsTextBox"/>

                        <WrapPanel Margin="0,20,0,0">
                            <Button Content="Применить профиль"
                                    Click="ApplyProfile_Click"
                                    Style="{DynamicResource AccentButton}"
                                    Padding="18,10"
                                    Margin="0,0,8,0"/>
                            <Button Content="Вернуть всё как было"
                                    Click="RevertProfile_Click"
                                    Padding="16,10"/>
                        </WrapPanel>

                        <TextBlock x:Name="SettingsStatusText"
                                   Style="{DynamicResource MutedText}"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Margin="0,12,0,0"/>
                        <TextBlock x:Name="OptimizationStatusText"
                                   Foreground="{DynamicResource AccentTextBrush}"
                                   FontSize="12"
                                   TextWrapping="Wrap"
                                   Margin="0,4,0,0"/>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <TextBlock x:Name="WindowStatusText"
                   Grid.Row="2"
                   Style="{DynamicResource MutedText}"
                   FontSize="12"
                   TextTrimming="CharacterEllipsis"
                   Margin="2,12,0,0"/>
    </Grid>
</UserControl>
