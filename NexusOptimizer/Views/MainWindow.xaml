<Window x:Class="NexusOptimizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:NexusOptimizer.Views"
        Title="Nexus Optimizer"
        Width="1280"
        Height="820"
        MinWidth="1000"
        MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="{StaticResource UiFont}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Боковая панель -->
        <Border Grid.Column="0"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource LineBrush}"
                BorderThickness="0,0,1,0">
            <DockPanel Margin="18,22,18,18" LastChildFill="False">

                <StackPanel DockPanel.Dock="Top"
                            Orientation="Horizontal"
                            Margin="4,0,0,28">
                    <Border Width="40"
                            Height="40"
                            CornerRadius="12"
                            Background="{StaticResource AccentBrush}">
                        <TextBlock Text="N"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Nexus Optimizer"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}"/>
                        <TextBlock Text="Игры и обслуживание ПК"
                                   FontSize="11"
                                   Foreground="{StaticResource MutedBrush}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel DockPanel.Dock="Top">
                    <RadioButton x:Name="NavLibrary"
                                 Style="{StaticResource NavButton}"
                                 GroupName="MainNavigation"
                                 IsChecked="True"
                                 Tag="Library"
                                 Content="Библиотека"
                                 Click="Nav_Click"/>
                    <RadioButton x:Name="NavCleanup"
                                 Style="{StaticResource NavButton}"
                                 GroupName="MainNavigation"
                                 Tag="Cleanup"
                                 Content="Очистка ПК"
                                 Click="Nav_Click"/>
                </StackPanel>

                <Border DockPanel.Dock="Bottom"
                        Background="{StaticResource SuccessSoftBrush}"
                        CornerRadius="10"
                        Padding="12,8"
                        ToolTip="Программа ничего не меняет в системе без вашего действия">
                    <TextBlock Text="Безопасный режим"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource SuccessBrush}"
                               HorizontalAlignment="Center"/>
                </Border>
            </DockPanel>
        </Border>

        <!-- Страницы -->
        <Grid Grid.Column="1" Margin="28,24,28,20">
            <views:LibraryView x:Name="LibraryPage"/>
            <views:GameDetailsView x:Name="GamePage" Visibility="Collapsed"/>
            <views:CleanupView x:Name="CleanupPage" Visibility="Collapsed"/>
        </Grid>
    </Grid>
</Window>
