<Window x:Class="NexusOptimizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:views="clr-namespace:NexusOptimizer.Views"
        Title="Nexus Optimizer"
        Icon="pack://application:,,,/Assets/NexusOptimizer.ico"
        Width="1280"
        Height="820"
        MinWidth="1000"
        MinHeight="680"
        WindowStyle="None"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource BgBrush}"
        Foreground="{DynamicResource TextBrush}"
        FontFamily="{DynamicResource UiFont}">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="42"
                            ResizeBorderThickness="6"
                            GlassFrameThickness="0"
                            CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="WindowCaptionButton" TargetType="Button">
            <Setter Property="Width" Value="46"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="shell:WindowChrome.IsHitTestVisibleInChrome" Value="True"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBackground"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBackground"
                                        Property="Background"
                                        Value="{DynamicResource ButtonBrush}"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBackground"
                                        Property="Opacity"
                                        Value="0.7"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="WindowCloseButton"
               TargetType="Button"
               BasedOn="{StaticResource WindowCaptionButton}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#C42B1C"/>
                    <Setter Property="Foreground" Value="White"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid x:Name="ShellRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="42"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="232"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Row="0"
                Grid.ColumnSpan="2"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource LineBrush}"
                BorderThickness="0,0,0,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            Margin="14,0,0,0"
                            VerticalAlignment="Center">
                    <Border Width="24"
                            Height="24"
                            CornerRadius="7"
                            Background="{DynamicResource AccentBrush}">
                        <TextBlock Text="N"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Nexus Optimizer"
                               Margin="9,0,0,0"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Button Style="{StaticResource WindowCaptionButton}"
                            Click="MinimizeWindow_Click"
                            ToolTip="Свернуть">
                        <TextBlock Text="—" FontSize="15"/>
                    </Button>
                    <Button x:Name="MaximizeRestoreButton"
                            Style="{StaticResource WindowCaptionButton}"
                            Click="MaximizeRestoreWindow_Click"
                            ToolTip="Развернуть">
                        <TextBlock x:Name="MaximizeRestoreGlyph" Text="□" FontSize="13"/>
                    </Button>
                    <Button Style="{StaticResource WindowCloseButton}"
                            Click="CloseWindow_Click"
                            ToolTip="Закрыть">
                        <TextBlock Text="×" FontSize="19"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Боковая панель -->
        <Border Grid.Row="1"
                Grid.Column="0"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource LineBrush}"
                BorderThickness="0,0,1,0">
            <DockPanel Margin="18,22,18,18" LastChildFill="False">

                <StackPanel DockPanel.Dock="Top"
                            Orientation="Horizontal"
                            Margin="4,0,0,28">
                    <Border Width="40"
                            Height="40"
                            CornerRadius="12"
                            Background="{DynamicResource AccentBrush}">
                        <TextBlock Text="N"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   Foreground="White"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Nexus Optimizer"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextBrush}"/>
                        <TextBlock Text="Игры и обслуживание ПК"
                                   FontSize="11"
                                   Foreground="{DynamicResource MutedBrush}"/>
                    </StackPanel>
                </StackPanel>

                <StackPanel DockPanel.Dock="Top">
                    <RadioButton x:Name="NavLibrary"
                                 Style="{DynamicResource NavButton}"
                                 GroupName="MainNavigation"
                                 IsChecked="True"
                                 Tag="Library"
                                 Content="Библиотека"
                                 Click="Nav_Click"/>
                    <RadioButton x:Name="NavCleanup"
                                 Style="{DynamicResource NavButton}"
                                 GroupName="MainNavigation"
                                 Tag="Cleanup"
                                 Content="Очистка ПК"
                                 Click="Nav_Click"/>
                    <RadioButton x:Name="NavPcTweaks"
                                 Style="{DynamicResource NavButton}"
                                 GroupName="MainNavigation"
                                 Tag="PcTweaks"
                                 Content="Настройка компьютера"
                                 Click="Nav_Click"/>
                    <RadioButton x:Name="NavSystemScan"
                                 Style="{DynamicResource NavButton}"
                                 GroupName="MainNavigation"
                                 Tag="SystemScan"
                                 Content="Умная настройка"
                                 Click="Nav_Click"/>
                </StackPanel>

                <StackPanel DockPanel.Dock="Bottom">
                    <Button x:Name="ThemeToggleButton"
                            Click="ThemeToggle_Click"
                            Style="{DynamicResource ThemeToggleButtonStyle}"
                            Margin="0,0,0,10"/>
                    <Border Background="{DynamicResource SuccessSoftBrush}"
                            CornerRadius="10"
                            Padding="12,8"
                            ToolTip="Программа ничего не меняет в системе без вашего действия">
                        <TextBlock Text="Безопасный режим"
                                   FontSize="12"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource SuccessBrush}"
                                   HorizontalAlignment="Center"/>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Страницы -->
        <Grid Grid.Row="1" Grid.Column="1" Margin="28,24,28,20">
            <views:LibraryView x:Name="LibraryPage"/>
            <views:GameDetailsView x:Name="GamePage" Visibility="Collapsed"/>
            <views:CleanupView x:Name="CleanupPage" Visibility="Collapsed"/>
            <views:PcTweaksView x:Name="PcTweaksPage" Visibility="Collapsed"/>
            <views:PcSystemScanView x:Name="PcSystemScanPage" Visibility="Collapsed"/>
        </Grid>
    </Grid>
</Window>
