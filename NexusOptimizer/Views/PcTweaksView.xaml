<UserControl x:Class="NexusOptimizer.Views.PcTweaksView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource BgBrush}"
             Foreground="{DynamicResource TextBrush}"
             FontFamily="{DynamicResource UiFont}">

    <UserControl.Resources>
        <Style x:Key="PcCategoryItemStyle" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,8,0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Card"
                                Background="{DynamicResource CardBrush}"
                                BorderBrush="{DynamicResource LineBrush}"
                                BorderThickness="1"
                                CornerRadius="12"
                                Padding="12">
                            <ContentPresenter VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Card" Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
                                <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="Настройка компьютера" Style="{DynamicResource PageTitleText}"/>
            <TextBlock Text="Общие настройки Windows: производительность, игры, приватность, автозагрузка и питание."
                       Style="{DynamicResource MutedText}"
                       Margin="0,5,0,0"/>
        </StackPanel>

        <Border Grid.Row="1"
                Background="{DynamicResource WarningSoftBrush}"
                CornerRadius="10"
                Padding="14,10"
                Margin="0,16,0,14">
            <TextBlock Text="Выберите настройки и нажмите «Применить». Исходные значения сохраняются для восстановления. Пресеты ничего не меняют до применения. Защитные функции Windows не отключаются."
                       Foreground="{DynamicResource BodyTextBrush}"
                       FontSize="12"
                       TextWrapping="Wrap"/>
        </Border>

        <StackPanel Grid.Row="2" Margin="0,0,0,14">
            <TextBlock Text="Категории" Style="{DynamicResource MutedText}" FontSize="12" Margin="0,0,0,7"/>
            <ListBox x:Name="CategoryList"
                     Background="Transparent"
                     BorderThickness="0"
                     Padding="0"
                     ItemContainerStyle="{StaticResource PcCategoryItemStyle}"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Disabled"
                     SelectionChanged="CategoryList_SelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="38"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Border Width="32"
                                    Height="32"
                                    CornerRadius="9"
                                    Background="{DynamicResource AccentSoftBrush}"
                                    VerticalAlignment="Center">
                                <TextBlock Text="{Binding Icon}"
                                           Foreground="{DynamicResource AccentTextBrush}"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"/>
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="8,0,0,0">
                                <TextBlock Text="{Binding Name}"
                                           Foreground="{Binding RelativeSource={RelativeSource AncestorType=ListBoxItem}, Path=Foreground}"
                                           FontSize="11"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding CountText}"
                                           Foreground="{DynamicResource MutedBrush}"
                                           FontSize="10"
                                           Margin="0,3,0,0"/>
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="3"/>
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
            </ListBox>
            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <TextBlock Text="Пресет" Style="{DynamicResource MutedText}" FontSize="12" VerticalAlignment="Center" Margin="0,0,12,0"/>
                <ListBox x:Name="PresetList"
                         Style="{DynamicResource ChipListBoxStyle}"
                         SelectionChanged="PresetList_SelectionChanged"/>
            </StackPanel>
        </StackPanel>

        <Border Grid.Row="3" Style="{DynamicResource PanelCard}" Padding="12">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="TweaksList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{DynamicResource CardBrush}"
                                    BorderBrush="{DynamicResource LineBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="16"
                                    Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              IsEnabled="{Binding IsAvailable}"
                                              VerticalAlignment="Top"
                                              Margin="0,2,12,0"/>
                                    <StackPanel Grid.Column="1">
                                        <DockPanel LastChildFill="True">
                                            <Border DockPanel.Dock="Right"
                                                    Background="{DynamicResource AccentSoftBrush}"
                                                    CornerRadius="7"
                                                    Padding="8,3"
                                                    Margin="10,0,0,0">
                                                <TextBlock Text="{Binding ScopeText}"
                                                           Foreground="{DynamicResource AccentTextBrush}"
                                                           FontSize="10"
                                                           FontWeight="SemiBold"/>
                                            </Border>
                                            <TextBlock Text="{Binding Name}"
                                                       Foreground="{DynamicResource TextBrush}"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       TextWrapping="Wrap"/>
                                        </DockPanel>
                                        <TextBlock Text="{Binding Description}"
                                                   Style="{DynamicResource MutedText}"
                                                   FontSize="12"
                                                   TextWrapping="Wrap"
                                                   Margin="0,6,0,0"/>
                                        <TextBlock Text="{Binding Caution}"
                                                   Foreground="{DynamicResource WarningBrush}"
                                                   FontSize="11"
                                                   TextWrapping="Wrap"
                                                   Margin="0,5,0,0"/>
                                        <TextBlock Text="{Binding AvailabilityText}"
                                                   Foreground="{DynamicResource WarningBrush}"
                                                   FontSize="11"
                                                   TextWrapping="Wrap"
                                                   Margin="0,5,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <Grid Grid.Row="4" Margin="0,14,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="StatusText"
                       Style="{DynamicResource MutedText}"
                       FontSize="12"
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"
                       Margin="0,0,16,0"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="RestoreButton"
                        Content="Вернуть исходное"
                        Click="Restore_Click"
                        Margin="0,0,8,0"/>
                <Button x:Name="ApplyButton"
                        Content="Применить"
                        Click="Apply_Click"
                        Style="{DynamicResource AccentButton}"
                        Margin="0,0,8,0"/>
                <Button Content="Назад в библиотеку" Click="Back_Click"/>
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>
