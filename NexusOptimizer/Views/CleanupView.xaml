<UserControl x:Class="NexusOptimizer.Views.CleanupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="Очистка ПК" Style="{StaticResource PageTitleText}"/>
        <TextBlock Text="Раздел пока в разработке"
                   Style="{StaticResource MutedText}"
                   Margin="0,4,0,20"/>

        <Border Style="{StaticResource PanelCard}"
                MaxWidth="640"
                HorizontalAlignment="Left">
            <StackPanel>
                <TextBlock Text="Очистка временных файлов"
                           Style="{StaticResource SectionTitleText}"/>
                <TextBlock Style="{StaticResource MutedText}"
                           TextWrapping="Wrap"
                           LineHeight="21"
                           Margin="0,10,0,0"
                           Text="Здесь появится список временных файлов и кэшей с размером каждой категории. Вы отметите, что удалить, и программа покажет итог до удаления. Удаляться будет только то, что вы отметили."/>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
