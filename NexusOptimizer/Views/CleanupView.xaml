<UserControl x:Class="NexusOptimizer.Views.CleanupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок и действия -->
        <Grid Grid.Row="0" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Очистка ПК" Style="{StaticResource PageTitleText}"/>
                <TextBlock Text="{Binding Summary}"
                           Style="{StaticResource MutedText}"
                           Margin="0,4,0,0"/>
            </StackPanel>

            <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">
                <Button Content="Отменить"
                        Click="Cancel_Click"
                        Height="40"
                        Padding="18,9"
                        Margin="0,0,10,0"
                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}"/>
                <Button Content="Проанализировать"
                        Click="Analyze_Click"
                        IsEnabled="{Binding CanAnalyze}"
                        Height="40"
                        Padding="18,9"
                        Margin="0,0,10,0"/>
                <Button Content="Очистить выбранное"
                        Click="Clean_Click"
                        IsEnabled="{Binding CanClean}"
                        Style="{StaticResource AccentButton}"
                        Height="40"
                        MinWidth="170"/>
            </StackPanel>
        </Grid>

        <TextBlock Grid.Row="1"
                   Style="{StaticResource MutedText}"
                   FontSize="12"
                   TextWrapping="Wrap"
                   LineHeight="19"
                   Margin="0,0,0,14"
                   Text="Программа удаляет только файлы из временных папок и кэшей. Файлы, которые менялись меньше суток назад, и файлы, занятые другими программами, пропускаются. Перед удалением вы увидите итог и подтвердите его."/>

        <!-- Категории -->
        <Border Grid.Row="2"
                Style="{StaticResource PanelCard}"
                Padding="18,18,8,8">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <ItemsControl ItemsSource="{Binding Items}" Margin="0,0,10,0">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Background="{StaticResource CardBrush}"
                                    BorderBrush="{StaticResource LineBrush}"
                                    BorderThickness="1"
                                    CornerRadius="12"
                                    Padding="16"
                                    Margin="0,0,0,10"
                                    ToolTip="{Binding FoldersHint}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <CheckBox Grid.Column="0"
                                              IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              VerticalAlignment="Top"
                                              Margin="0,1,6,0"/>

                                    <StackPanel Grid.Column="1" Margin="0,0,16,0">
                                        <TextBlock Text="{Binding Title}"
                                                   FontSize="15"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextBrush}"/>
                                        <TextBlock Text="{Binding Description}"
                                                   Style="{StaticResource MutedText}"
                                                   FontSize="12"
                                                   LineHeight="18"
                                                   TextWrapping="Wrap"
                                                   Margin="0,4,0,0"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2"
                                                MinWidth="120"
                                                VerticalAlignment="Top">
                                        <TextBlock Text="{Binding SizeText}"
                                                   FontSize="14"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource AccentTextBrush}"
                                                   TextAlignment="Right"/>
                                        <TextBlock Text="{Binding FilesText}"
                                                   Style="{StaticResource MutedText}"
                                                   FontSize="11"
                                                   TextAlignment="Right"
                                                   Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <TextBlock Grid.Row="3"
                   Text="{Binding Status}"
                   Style="{StaticResource MutedText}"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Margin="2,12,0,0"/>
    </Grid>
</UserControl>
