<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>NexusOptimizer</RootNamespace>
    <AssemblyName>NexusOptimizer</AssemblyName>
    <ApplicationIcon>Assets\NexusOptimizer.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets\NexusOptimizer.ico" />
    <InternalsVisibleTo Include="NexusOptimizer.Tests" />
  </ItemGroup>
</Project>
