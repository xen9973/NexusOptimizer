<Window x:Class="NexusOptimizer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:converters="clr-namespace:NexusOptimizer.Converters"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nexus Optimizer"
        Height="800" Width="1240"
        MinHeight="650" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="#111318"
        Foreground="#F2F4F8">

    <Window.Resources>
        <converters:GameIconConverter x:Key="GameIconConverter"/>
        <converters:GameIconVisibilityConverter x:Key="GameIconVisibilityConverter"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#191C23"/>
        <SolidColorBrush x:Key="CardBrush" Color="#20242D"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#303642"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#9AA3B2"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#4F8CFF"/>

        <Style TargetType="Button">
            <Setter Property="Background" Value="#292F3A"/>
            <Setter Property="Foreground" Value="#F2F4F8"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="13,9"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity" Value="0.82"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity" Value="0.45"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#20242D"/>
            <Setter Property="Foreground" Value="#F2F4F8"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="BorderBrush" Value="#303642"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="12,9"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#20242D"/>
            <Setter Property="Foreground" Value="#F2F4F8"/>
            <Setter Property="BorderBrush" Value="#303642"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="MinHeight" Value="38"/>
        </Style>

        <Style TargetType="ScrollBar">
            <Setter Property="Background" Value="#191C23"/>
        </Style>
    </Window.Resources>

    <Grid Margin="26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок -->
        <Grid Grid.Row="0" Margin="0,0,0,24">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal">
                <Border Width="48" Height="48"
                        CornerRadius="13"
                        Background="#4F8CFF"
                        Margin="0,0,14,0">
                    <TextBlock Text="N"
                               FontSize="27"
                               FontWeight="Bold"
                               Foreground="White"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Border>

                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Nexus Optimizer"
                               FontSize="25"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="Игровая библиотека и обслуживание ПК"
                               FontSize="12"
                               Foreground="{StaticResource MutedBrush}"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </StackPanel>

            <Border Grid.Column="1"
                    Background="#20342F"
                    BorderBrush="#2D5147"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="12,8"
                    VerticalAlignment="Center">
                <TextBlock Text="●  БЕЗОПАСНЫЙ РЕЖИМ"
                           Foreground="#54D6A0"
                           FontSize="10"
                           FontWeight="Bold"/>
            </Border>
        </Grid>

        <!-- Счётчики -->
        <Grid Grid.Row="1" Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <Border Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="17"
                    Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="ВСЕГО НАЙДЕНО ИГР"
                               FontSize="10"
                               Foreground="{StaticResource MutedBrush}"/>
                    <TextBlock Text="{Binding TotalGamesCount}"
                               FontSize="28"
                               FontWeight="SemiBold"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <Border Grid.Column="1"
                    Background="{StaticResource PanelBrush}"
                    BorderBrush="{StaticResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="17"
                    Margin="0,0,12,0">
                <StackPanel>
                    <TextBlock Text="ОТОБРАЖАЕТСЯ"
                               FontSize="10"
                               Foreground="{StaticResource MutedBrush}"/>
                    <TextBlock Text="{Binding VisibleGamesCount}"
                               FontSize="28"
                               FontWeight="SemiBold"
                               Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <Button Grid.Column="2"
                    Content="＋  Добавить папку"
                    Click="AddFolder_Click"
                    Height="42"
                    Margin="0,0,10,0"
                    VerticalAlignment="Center"/>

            <Button Grid.Column="3"
                    Content="{Binding ScanButtonText}"
                    Click="Scan_Click"
                    Background="{StaticResource AccentBrush}"
                    Foreground="White"
                    Height="42"
                    MinWidth="145"
                    VerticalAlignment="Center"/>
        </Grid>

        <!-- Поиск и фильтры -->
        <Grid Grid.Row="2" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="220"/>
            </Grid.ColumnDefinitions>

            <Grid Grid.Column="0" Margin="0,0,12,0">
                <TextBox x:Name="SearchBox"
                         Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                         ToolTip="Поиск по названию, источнику или пути"
                         Padding="38,9,12,9"/>

                <TextBlock Text="⌕"
                           FontSize="23"
                           Foreground="#9AA3B2"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Center"
                           Margin="12,0,0,3"
                           IsHitTestVisible="False"/>

                <TextBlock Text="Поиск по названию, платформе или пути..."
                           Foreground="#788394"
                           FontSize="12"
                           VerticalAlignment="Center"
                           Margin="39,0,10,0"
                           IsHitTestVisible="False">
                    <TextBlock.Style>
                        <Style TargetType="{x:Type TextBlock}">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=SearchBox}"
                                             Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>

            <ComboBox Grid.Column="1"
                      ItemsSource="{Binding PlatformFilters}"
                      SelectedItem="{Binding SelectedPlatform, UpdateSourceTrigger=PropertyChanged}"
                      Foreground="Black"/>
        </Grid>

        <!-- Библиотека -->
        <Border Grid.Row="3"
                Background="{StaticResource PanelBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                CornerRadius="14"
                Padding="18">

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <StackPanel Margin="0,0,0,16">
                    <TextBlock Text="Твоя библиотека"
                               FontSize="18"
                               FontWeight="SemiBold"/>
                    <TextBlock Text="Найденные игры и расположение файлов"
                               FontSize="12"
                               Foreground="{StaticResource MutedBrush}"
                               Margin="0,5,0,0"/>
                </StackPanel>

                <ScrollViewer Grid.Row="1"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">

                    <ItemsControl ItemsSource="{Binding FilteredGames}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>

                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="300"
                                        MinWidth="260"
                                        MinHeight="210"
                                        Margin="0,0,14,14"
                                        Padding="16"
                                        CornerRadius="12"
                                        Background="{StaticResource CardBrush}"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="1">

                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="*"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>

                                        <Grid Grid.Row="0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="42"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <Border Width="42"
        Height="42"
        CornerRadius="10"
        Background="#293B5B"
        ClipToBounds="True">

                                                <Grid>
                                                    <!-- Настоящая иконка приложения -->
                                                    <Image Source="{Binding InstallPath,
                        Converter={StaticResource GameIconConverter}}"
               Width="42"
               Height="42"
               Stretch="Uniform"
               RenderOptions.BitmapScalingMode="HighQuality"/>

                                                    <!-- Запасной значок, если иконку получить не удалось -->
                                                    <TextBlock Text="🎮"
                   FontSize="19"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Visibility="{Binding InstallPath,
                       Converter={StaticResource GameIconVisibilityConverter}}"/>
                                                </Grid>
                                            </Border>

                                            <StackPanel Grid.Column="1"
                                                        Margin="10,0,0,0"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}"
                                                           FontSize="14"
                                                           FontWeight="SemiBold"
                                                           TextTrimming="CharacterEllipsis"
                                                           ToolTip="{Binding Name}"/>
                                                <TextBlock Text="{Binding Platform}"
                                                           FontSize="11"
                                                           Foreground="{StaticResource MutedBrush}"
                                                           Margin="0,3,0,0"/>
                                            </StackPanel>
                                        </Grid>

                                        <Border Grid.Row="1"
                                                HorizontalAlignment="Left"
                                                Margin="0,12,0,8"
                                                Background="#20342F"
                                                CornerRadius="9"
                                                Padding="8,4">
                                            <TextBlock Text="{Binding Status}"
                                                       FontSize="10"
                                                       Foreground="#54D6A0"/>
                                        </Border>

                                        <TextBlock Grid.Row="2"
                                                   Text="{Binding InstallPath}"
                                                   FontSize="10"
                                                   Foreground="{StaticResource MutedBrush}"
                                                   TextWrapping="Wrap"
                                                   TextTrimming="CharacterEllipsis"
                                                   MaxHeight="42"
                                                   ToolTip="{Binding InstallPath}"
                                                   Margin="0,0,0,12"/>

                                        <Grid Grid.Row="3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <Button Content="Открыть папку"
                                                    Click="OpenFolder_Click"
                                                    Tag="{Binding}"
                                                    Padding="8,8"
                                                    Margin="0,0,6,0"/>

                                            <Button Grid.Column="1"
                                                    Content="Копировать путь"
                                                    Click="CopyPath_Click"
                                                    Tag="{Binding}"
                                                    Padding="8,8"
                                                    Background="#243B60"
                                                    Foreground="#BBD2FF"/>
                                        </Grid>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Статус -->
        <DockPanel Grid.Row="4" Margin="2,14,2,0">
            <TextBlock Text="{Binding Status}"
                       Foreground="{StaticResource MutedBrush}"
                       FontSize="11"
                       VerticalAlignment="Center"/>

            <TextBlock DockPanel.Dock="Right"
                       Text=" Оптимизация системы пока не применяется"
                       Foreground="{StaticResource MutedBrush}"
                       FontSize="11"/>
        </DockPanel>
    </Grid>
</Window>
